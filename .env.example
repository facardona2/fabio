# Cuenta XM (MetaTrader 5)
MT5_LOGIN=12345678
MT5_PASSWORD=tu_password
MT5_SERVER=XMGlobal-Real
MT5_PATH=C:/Program Files/XM Global MT5/terminal64.exe

# Bot de Telegram
# 1) Hablar con @BotFather en Telegram, /newbot, copiar el token
# 2) Hablar con @userinfobot para obtener tu chat_id
TELEGRAM_TOKEN=123456789:ABCDEF...
TELEGRAM_CHAT_ID=987654321

# Intervalo de escaneo en segundos (300 = 5 min, recomendado para M15)
SCAN_INTERVAL=300

# Modo (LIVE = manda alertas, DRY = solo imprime en consola)
MODE=LIVE
